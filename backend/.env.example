NODE_ENV=development
PORT=3000
API_VERSION=v1

DATABASE_URL=postgresql://parkwalk:parkwalk_dev@localhost:5432/parkwalk?schema=public

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string-in-dev-too
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Browser origins only. Mobile apps usually send no Origin header.
# Add hosted dashboard/staging origins explicitly; do not rely on private-IP CORS fallbacks.
ALLOWED_ORIGINS=https://parkwalk-production.up.railway.app,http://localhost:5173

LOG_LEVEL=debug

SEED_CENTER_LAT=37.7749
SEED_CENTER_LNG=-122.4194
SEED_ENTITY_COUNT=15
# Disc radius in meters. Use ~80 for a tight first-walk test area,
# ~500 for a neighborhood walk, larger for proper Alpha dog-fooding.
# Minimum 15m (enforced in backend/src/env.ts).
SEED_SCATTER_METERS=80
# Minimum distance between any two seeded markers (prevents collection-radius
# overlap so the player actually has to walk between pickups).
SEED_MIN_SPACING_METERS=12

# Development helper: when enabled, GET /entities/nearby tops up a shared
# cluster of collectibles around the requested location if too few uncollected
# markers are visible to that user. Keep false in production until real spawn
# policy / moderation rules exist.
NEARBY_AUTO_SEED_ENABLED=false
NEARBY_AUTO_SEED_TARGET_COUNT=12
NEARBY_AUTO_SEED_RADIUS_METERS=140
NEARBY_AUTO_SEED_MIN_DISTANCE_METERS=25
NEARBY_AUTO_SEED_MIN_SPACING_METERS=18

# Optional Alpha helper: snap auto-seeded/dev-seeded collectibles to Mapbox
# Streets walkable road/path line features. Requires a Mapbox token when true.
MAPBOX_ACCESS_TOKEN=
WALKABLE_SNAPPING_ENABLED=false
WALKABLE_SNAP_MAX_METERS=35
WALKABLE_SNAP_CACHE_TTL_SECONDS=86400
WALKABLE_SNAP_REQUIRED=false
WALKABLE_TILEQUERY_MAX_CALLS=8
