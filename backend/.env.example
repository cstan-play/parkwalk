NODE_ENV=development
PORT=3000
API_VERSION=v1

DATABASE_URL=postgresql://parkwalk:parkwalk_dev@localhost:5432/parkwalk?schema=public

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-string-in-dev-too
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=debug

SEED_CENTER_LAT=37.7749
SEED_CENTER_LNG=-122.4194
SEED_ENTITY_COUNT=15
# Disc radius in meters. Use ~80 for a Wi-Fi-tethered test walk (apartment /
# garden), ~500 for a neighborhood walk on cellular/ngrok, larger for proper
# Alpha dog-fooding. Minimum 15m (enforced in backend/src/env.ts).
SEED_SCATTER_METERS=80
# Minimum distance between any two seeded markers (prevents collection-radius
# overlap so the player actually has to walk between pickups).
SEED_MIN_SPACING_METERS=12

