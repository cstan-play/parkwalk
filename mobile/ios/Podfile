require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# react-native-permissions: hoisted to repo-root node_modules via npm workspaces.
require_relative '../../node_modules/react-native-permissions/scripts/setup'

platform :ios, '15.0'
prepare_react_native_project!

# Register the iOS permission handlers we actually use. Each name maps to a
# CocoaPods subspec of react-native-permissions. Without this, the native
# module exports no constants and the JS bridge crashes at startup with
# "No permission handler detected".
setup_permissions([
  'LocationWhenInUse',
  'LocationAlways',
  'Motion',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# Required by @rnmapbox/maps: select the mapbox implementation.
# Must be set BEFORE use_native_modules! so the rnmapbox-maps podspec picks it up.
$RNMapboxMapsImpl = 'mapbox'
$RNMapboxMapsVersion = '= 11.21.1'

target 'ParkWalk' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => ENV['RCT_NEW_ARCH_ENABLED'] == '1',
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pre_install do |installer|
    $RNMapboxMaps.pre_install(installer)
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    $RNMapboxMaps.post_install(installer)

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
