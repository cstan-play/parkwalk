# Optional hosted HTTPS API override, e.g. a Railway staging service.
# Leave empty to use mobile/src/config/railwayPublicApi.ts.
API_BASE_URL=
MAPBOX_ACCESS_TOKEN=pk.your-public-token-here
# Optional Studio style override. Leave empty to use Mapbox Standard.
# Example: mapbox://styles/your-username/your-warm-style-id
MAPBOX_STYLE_URL=
# Set true for Metro-free outdoor Release builds that still need field telemetry.
FIELD_DEBUG_OVERLAY=false
SENTRY_DSN=
